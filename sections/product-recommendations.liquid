<product-recommendations class="container section" style="display:block;--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px;--cols:{{ section.settings.columns }}" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.count }}&intent={{ section.settings.intent }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, outline: section.settings.heading_outline %}
    <div class="grid-products {% if section.settings.mobile_carousel %}grid-products--carousel{% endif %}">
      {%- for recommendation in recommendations.products -%}
        {% render 'product-card', product: recommendation, quick_add: section.settings.quick_add %}
      {%- endfor -%}
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "More to explore" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may" },
    { "type": "text", "id": "heading_outline", "label": "Outlined heading text", "default": "also like" },
    { "type": "select", "id": "intent", "label": "Recommendation type", "default": "related", "options": [ { "value": "related", "label": "Related" }, { "value": "complementary", "label": "Complementary" } ] },
    { "type": "range", "id": "count", "label": "Products to show", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "mobile_carousel", "label": "Swipeable carousel on mobile", "default": true },
    { "type": "checkbox", "id": "quick_add", "label": "Show quick add", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [{ "name": "Product recommendations" }]
}
{% endschema %}
