<section class="sec brands" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px" aria-labelledby="brands-{{ section.id }}">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="d h2" id="brands-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a class="lbl u" href="{{ section.settings.link_url | default: routes.collections_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    <div class="grid brands__grid brands__grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <a class="brands__tile ph ph--{{ forloop.index | modulo: 5 | plus: 1 }}" href="{{ block.settings.link | default: routes.collections_url }}" style="aspect-ratio:{{ section.settings.ratio }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 1000px) 25vw, 50vw', alt: block.settings.name }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
          <span class="brands__name d">{{ block.settings.name }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .brands__grid--3{grid-template-columns:repeat(3,minmax(0,1fr))}
  .brands__grid--4{grid-template-columns:repeat(4,minmax(0,1fr))}
  .brands__grid--5{grid-template-columns:repeat(5,minmax(0,1fr))}
  .brands__tile{display:block}
  .brands__name{position:absolute;left:0;bottom:0;background:#fff;color:#000;padding:14px 18px;font-size:26px;border-top:1px solid #000;border-right:1px solid #000;z-index:1}
  .brands__tile:hover .brands__name{background:#000;color:#fff}
  @media (max-width:1000px){
    .brands__grid--3,.brands__grid--4,.brands__grid--5{grid-template-columns:repeat(2,minmax(0,1fr))}
    .brands__name{font-size:20px;padding:10px 12px}
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by brand",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by brand" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All brands" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" } ], "default": "4" },
    { "type": "select", "id": "ratio", "label": "Tile shape", "options": [ { "value": "4/5", "label": "Portrait 4:5" }, { "value": "1/1", "label": "Square" }, { "value": "3/4", "label": "Tall 3:4" } ], "default": "4/5" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Brand name", "default": "Nike" },
        { "type": "image_picker", "id": "image", "label": "Full-bleed photo" },
        { "type": "url", "id": "link", "label": "Link", "info": "Usually the brand collection." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Shop by brand",
      "blocks": [
        { "type": "brand", "settings": { "name": "Nike" } },
        { "type": "brand", "settings": { "name": "Jordan" } },
        { "type": "brand", "settings": { "name": "adidas" } },
        { "type": "brand", "settings": { "name": "New Balance" } }
      ]
    }
  ]
}
{% endschema %}
