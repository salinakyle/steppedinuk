<div class="container section" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
  <figure class="testimonial">
    <div>
      <div class="stars" role="img" aria-label="{{ section.settings.stars }} / 5">
        {%- for i in (1..section.settings.stars) -%}{% render 'icon', name: 'star', size: 26 %}{%- endfor -%}
      </div>
      <blockquote class="display">“{{ section.settings.quote | escape }}{% if section.settings.quote_outline != blank %} <span class="ital">{{ section.settings.quote_outline | escape }}</span>{% endif %}”</blockquote>
    </div>
    <figcaption class="testimonial__body">
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn" style="align-self:flex-start" href="{{ section.settings.button_link | default: '#' }}" {% if section.settings.button_link contains 'http' %}rel="noopener" target="_blank"{% endif %}>{{ section.settings.button_label | escape }} →</a>
      {%- endif -%}
    </figcaption>
  </figure>
</div>

{% schema %}
{
  "name": "Testimonial",
  "settings": [
    { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "text", "id": "quote", "label": "Quote", "default": "Wow, great" },
    { "type": "text", "id": "quote_outline", "label": "Outlined quote text", "default": "customer service." },
    { "type": "textarea", "id": "text", "label": "Review text", "default": "An order problem, fixed quickly." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read our Trustpilot reviews" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Testimonial" }]
}
{% endschema %}
