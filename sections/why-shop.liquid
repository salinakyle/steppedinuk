<style>
  /* Desktop: 3 columns */
  #shopify-section-{{ section.id }} .why-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
  /* Tablet: 2 columns */
  @media (max-width:989px){
    #shopify-section-{{ section.id }} .why-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  }
  /* Mobile: swipe carousel */
  @media (max-width:749px){
    #shopify-section-{{ section.id }} .why-grid{
      display:flex;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;
      scrollbar-width:none;overscroll-behavior-x:contain;margin-right:-16px;border-right:0;
    }
    #shopify-section-{{ section.id }} .why-grid::-webkit-scrollbar{display:none}
    #shopify-section-{{ section.id }} .why-grid>.why{flex:0 0 82%;scroll-snap-align:start;min-width:0}
    #shopify-section-{{ section.id }} .why-grid>.why:last-child{margin-right:16px}
  }
  .why-dots{display:none}
  @media (max-width:749px){
    .why-dots{display:flex;justify-content:center;align-items:center;gap:2px;margin-top:16px}
    .why-dots button{height:24px;padding:0 3px;border:0;background:transparent;display:flex;align-items:center}
    .why-dots button span{display:block;height:6px;width:6px;border-radius:3px;background:#b8b8b8;transition:width .25s ease,background .25s ease}
    .why-dots button[aria-current="true"] span{width:18px;background:var(--color-text)}
  }
</style>

<div class="container section" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
  <h2 class="display display-xl" style="margin-bottom:36px">{{ section.settings.heading | escape }}{% if section.settings.heading_outline != blank %} <span class="ital">{{ section.settings.heading_outline | escape }}</span>{% endif %}</h2>
  <div class="why-grid" data-why-carousel>
    {%- for block in section.blocks -%}
      <div class="why" {{ block.shopify_attributes }}>
        <div class="why__top">
          <span class="why__n">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          <span class="why__icon">{% render 'icon', name: block.settings.icon, size: 44, stroke_width: 1.5 %}</span>
        </div>
        <div class="why__title">{{ block.settings.title | escape }}</div>
        <p class="why__body">{{ block.settings.text | escape }}</p>
      </div>
    {%- endfor -%}
  </div>
  <div class="why-dots" data-why-dots></div>
</div>

<script>
  (function(){
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if(!root) return;
    var track = root.querySelector('[data-why-carousel]');
    var dotsWrap = root.querySelector('[data-why-dots]');
    if(!track || !dotsWrap) return;
    var items = track.children, dots = [];
    for(var i=0;i<items.length;i++){
      (function(i){
        var b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('aria-label','Go to item '+(i+1));
        b.innerHTML = '<span></span>';
        b.addEventListener('click', function(){ track.scrollTo({left: items[i].offsetLeft - track.offsetLeft, behavior:'smooth'}); });
        dotsWrap.appendChild(b); dots.push(b);
      })(i);
    }
    function update(){
      var x = track.scrollLeft, best = 0, min = Infinity;
      for(var i=0;i<items.length;i++){
        var d = Math.abs((items[i].offsetLeft - track.offsetLeft) - x);
        if(d < min){ min = d; best = i; }
      }
      if(track.scrollLeft + track.clientWidth >= track.scrollWidth - 4) best = items.length - 1;
      dots.forEach(function(d,i){ if(i===best) d.setAttribute('aria-current','true'); else d.removeAttribute('aria-current'); });
    }
    track.addEventListener('scroll', function(){ window.requestAnimationFrame(update); }, {passive:true});
    window.addEventListener('resize', update);
    update();
  })();
</script>

{% schema %}
{
  "name": "Benefits grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why shop" },
    { "type": "text", "id": "heading_outline", "label": "Outlined heading text", "default": "with us" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "returns", "options": [
          { "value": "delivery", "label": "Delivery" }, { "value": "returns", "label": "Returns" }, { "value": "authentic", "label": "Authentic shield" },
          { "value": "secure", "label": "Secure lock" }, { "value": "card", "label": "Card" }, { "value": "worldwide", "label": "Globe" },
          { "value": "star-outline", "label": "Star" }, { "value": "box", "label": "Box" }, { "value": "clock", "label": "Clock" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "14-day returns" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Changed your mind or the fit is off? Send it back within 14 days." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits grid",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "returns", "title": "14-day returns", "text": "Changed your mind or the fit is off? Send it back within 14 days." } },
        { "type": "benefit", "settings": { "icon": "authentic", "title": "100% authentic", "text": "Every pair is verified before it leaves our warehouse." } },
        { "type": "benefit", "settings": { "icon": "secure", "title": "Secure checkout", "text": "Encrypted payments with the cards and wallets you already use." } },
        { "type": "benefit", "settings": { "icon": "card", "title": "Pay with Klarna", "text": "Spread the cost on eligible orders." } },
        { "type": "benefit", "settings": { "icon": "worldwide", "title": "Express worldwide", "text": "Fast, tracked delivery to the countries in our shipping list." } },
        { "type": "benefit", "settings": { "icon": "star-outline", "title": "Rated on Trustpilot", "text": "Real customers, real reviews, linked below." } }
      ]
    }
  ]
}
{% endschema %}
