{%- if section.blocks.size > 0 -%}
<div class="marquee scheme-{{ section.settings.color_scheme }}" style="--speed:{{ section.settings.speed }}s" aria-hidden="true">
  <div class="marquee__track">
    {%- for i in (1..4) -%}
      <div class="marquee__group">
        {%- for block in section.blocks -%}
          <span class="marquee__item" {% if i == 1 %}{{ block.shopify_attributes }}{% endif %}>{%- if block.settings.logo -%}<img class="marquee__logo" src="{{ block.settings.logo | image_url: height: 100 }}" alt="{{ block.settings.text | escape }}" height="28" loading="lazy">{%- else -%}{{ block.settings.text | escape }}{%- endif -%} <span>✦</span></span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Scrolling text",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "default": "light", "options": [
      { "value": "light", "label": "Light" }, { "value": "grey", "label": "Grey" }, { "value": "dark", "label": "Dark" }
    ] },
    { "type": "range", "id": "speed", "label": "Loop duration", "min": 10, "max": 90, "step": 2, "unit": "s", "default": 40 }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Nike" }, { "type": "image_picker", "id": "logo", "label": "Brand logo (shown in black)" } ] }
  ],
  "presets": [
    {
      "name": "Scrolling text",
      "blocks": [
        { "type": "item", "settings": { "text": "Nike" } }, { "type": "item", "settings": { "text": "ASICS" } },
        { "type": "item", "settings": { "text": "UGG" } }, { "type": "item", "settings": { "text": "Saucony" } },
        { "type": "item", "settings": { "text": "HOKA" } }, { "type": "item", "settings": { "text": "Air Jordan" } },
        { "type": "item", "settings": { "text": "Adidas" } }, { "type": "item", "settings": { "text": "Pokémon" } }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
.marquee__logo { height: 28px; width: auto; max-width: none; display: inline-block; vertical-align: middle; filter: brightness(0); }
{% endstylesheet %}