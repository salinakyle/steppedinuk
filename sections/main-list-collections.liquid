<section class="lc" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="wrap">
    <h1 class="d h1">{{ section.settings.heading }}</h1>
    <div class="grid grid--3 lc__grid">
      {%- for collection in collections -%}
        <a class="lc__item" href="{{ collection.url }}">
          <div class="ph" style="aspect-ratio:4/5">
            {%- if collection.featured_image -%}{{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 1000px) 30vw, 50vw', alt: collection.title }}
            {%- else -%}{{ 'collection-1' | placeholder_svg_tag }}{%- endif -%}
          </div>
          <div class="d lc__t">{{ collection.title }}</div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% stylesheet %}.lc h1{margin-bottom:32px}.lc__grid{gap:24px}.lc__item img{width:100%;height:100%;object-fit:cover;display:block}.lc__t{font-size:22px;font-weight:700;margin-top:12px}{% endstylesheet %}
{% schema %}
{ "name": "Collections list", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }, { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 } ] }
{% endschema %}
