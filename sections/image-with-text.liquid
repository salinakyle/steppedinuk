{%- assign s = section.settings -%}{%- capture media_style -%}position:relative;{% if s.image_width < 100 %}width:{{ s.image_width }}%;margin-inline:auto;{% endif %}{% if s.image_height > 0 %}height:{{ s.image_height }}px;{% endif %}{% if s.image_radius > 0 %}border-radius:{{ s.image_radius }}px;overflow:hidden;{% endif %}{%- endcapture -%}{%- capture img_style -%}{% if s.image_height > 0 %}width:100%;height:100%;object-fit:{{ s.image_fit }};object-position:{{ s.image_position }};{% endif %}filter:grayscale({{ s.filter_grayscale }}%) sepia({{ s.filter_sepia }}%) brightness({{ s.filter_brightness }}%) contrast({{ s.filter_contrast }}%) saturate({{ s.filter_saturate }}%) blur({{ s.filter_blur }}px) hue-rotate({{ s.filter_hue }}deg);opacity:{{ s.image_opacity | divided_by: 100.0 }};{%- endcapture -%}<div class="scheme-{{ section.settings.color_scheme }}">
  <div class="container section" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
    <div class="iwt {% if section.settings.flip %}iwt--flip{% endif %}">
      <div class="iwt__media" style="{{ media_style }}">
        {%- if section.settings.image != blank -%}
          {{- section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 990px) 45vw, 90vw', alt: section.settings.image.alt, style: img_style -}}
        {%- else -%}
          <span style="width:70%;color:#000">{% render 'shoe-placeholder' %}</span>
        {%- endif -%}
      </div>
      <div class="rich">
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
        <h2 class="display display-lg">{{ section.settings.heading | escape }}{% if section.settings.heading_outline != blank %} <span class="ital">{{ section.settings.heading_outline | escape }}</span>{% endif %}</h2>
        {%- if section.settings.text != blank -%}<div class="rte" style="font-size:18px;line-height:1.55">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank -%}<a class="btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "default": "light", "options": [
      { "value": "light", "label": "Light" }, { "value": "grey", "label": "Grey" }, { "value": "dark", "label": "Dark" }
    ] },
    { "type": "image_picker", "id": "image", "label": "Image" }, { "type": "header", "content": "Image size" }, { "type": "range", "id": "image_width", "label": "Image width", "min": 30, "max": 100, "step": 1, "unit": "%", "default": 100 }, { "type": "range", "id": "image_height", "label": "Image height (0 = auto)", "min": 0, "max": 900, "step": 10, "unit": "px", "default": 0 }, { "type": "select", "id": "image_fit", "label": "Image fit (when height is set)", "default": "cover", "options": [{ "value": "cover", "label": "Cover (crop)" }, { "value": "contain", "label": "Contain (no crop)" }, { "value": "fill", "label": "Stretch" }] }, { "type": "select", "id": "image_position", "label": "Focal point", "default": "center", "options": [{ "value": "center", "label": "Center" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" }, { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }] }, { "type": "range", "id": "image_radius", "label": "Corner radius", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 0 }, { "type": "header", "content": "Image filters" }, { "type": "range", "id": "filter_grayscale", "label": "Grayscale", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 0 }, { "type": "range", "id": "filter_sepia", "label": "Sepia", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 0 }, { "type": "range", "id": "filter_brightness", "label": "Brightness", "min": 50, "max": 150, "step": 5, "unit": "%", "default": 100 }, { "type": "range", "id": "filter_contrast", "label": "Contrast", "min": 50, "max": 150, "step": 5, "unit": "%", "default": 100 }, { "type": "range", "id": "filter_saturate", "label": "Saturation", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 100 }, { "type": "range", "id": "filter_blur", "label": "Blur", "min": 0, "max": 10, "step": 1, "unit": "px", "default": 0 }, { "type": "range", "id": "filter_hue", "label": "Hue rotate", "min": 0, "max": 360, "step": 5, "unit": "deg", "default": 0 }, { "type": "range", "id": "image_opacity", "label": "Opacity", "min": 10, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "checkbox", "id": "flip", "label": "Image on the right (desktop)", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Behind the pairs" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Checked, packed," },
    { "type": "text", "id": "heading_outline", "label": "Outlined heading text", "default": "shipped." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every pair is verified for authenticity and packed properly before it leaves our warehouse.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn more" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
