<announcement-bar class="announcement" {% if section.settings.autoplay %}data-autoplay="{{ section.settings.interval | times: 1000 }}"{% endif %}>
  <div class="announcement__inner">
    {%- if section.blocks.size > 1 -%}
      <button type="button" class="icon-btn" data-prev aria-label="{{ 'header.announcement_previous' | t }}">{% render 'icon', name: 'chevron-left', size: 16, stroke_width: 2 %}</button>
    {%- endif -%}
    <div class="announcement__text" aria-live="polite">
      {%- for block in section.blocks -%}
        <div class="announcement__msg" data-msg {{ block.shopify_attributes }} {% unless forloop.first %}hidden{% endunless %}>
          <span aria-hidden="true">●</span>&nbsp;
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" style="text-decoration:underline">{{ block.settings.text | escape }}</a>{%- else -%}{{ block.settings.text | escape }}{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 1 -%}
      <button type="button" class="icon-btn" data-next aria-label="{{ 'header.announcement_next' | t }}">{% render 'icon', name: 'chevron-right', size: 16, stroke_width: 2 %}</button>
    {%- endif -%}
  </div>
</announcement-bar>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate announcements", "default": true },
    { "type": "range", "id": "interval", "label": "Change every", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Fresh kicks. Fast delivery" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "announcement", "settings": { "text": "Fresh kicks. Fast delivery" } },
      { "type": "announcement", "settings": { "text": "14-day returns on every order" } },
      { "type": "announcement", "settings": { "text": "Summer sale now on" } }
    ]
  }
}
{% endschema %}
