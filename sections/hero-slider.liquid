<hero-slider class="hero" style="--hero-h:{{ section.settings.height }}px" role="region" aria-roledescription="carousel" aria-label="{{ section.settings.aria_label | escape }}" {% if section.settings.autoplay and section.blocks.size > 1 %}data-autoplay="{{ section.settings.interval | times: 1000 }}"{% endif %}>
  {%- if section.settings.show_badge -%}
    <div class="rotating-badge" aria-hidden="true" data-badge>
      <svg class="spin" viewBox="0 0 120 120" width="100%" height="100%"><defs><path id="badge-path-{{ section.id }}" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"/></defs><text font-size="10.5" font-family="DM Mono, monospace" font-weight="500" fill="currentColor"><textPath href="#badge-path-{{ section.id }}" textLength="286" lengthAdjust="spacing">{{ section.settings.badge_text | escape }} </textPath></text></svg>
      {% render 'icon', name: 'authentic', size: 40, stroke_width: 1.6, class: 'rotating-badge__icon' %}
    </div>
  {%- endif -%}

  <div class="hero__track" data-track>
    {%- for block in section.blocks -%}
      {%- liquid
        assign s = block.settings
        assign htag = 'h2'
        if forloop.first
          assign htag = 'h1'
        endif
        assign hero_img = s.image
        if hero_img == blank and s.product != blank
          assign hero_img = s.product.featured_image
        endif
        assign show_video = false
        assign video_kind = ''
        if s.video != blank or s.video_url != blank
          if s.video != blank
            assign show_video = true
            assign video_kind = 'file'
          elsif s.video_url != blank
            assign show_video = true
            assign video_kind = s.video_url.type
          endif
        endif
      -%}
      <div class="hero__slide scheme-{{ s.color_scheme }}" data-slide role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ forloop.length }}" {{ block.shopify_attributes }}>
        <div class="container hero__inner">
          <div class="hero__copy">
            {%- if s.kicker != blank -%}<div class="hero__kicker">{{ s.kicker | escape }}</div>{%- endif -%}
            <{{ htag }} class="display display-hero">{{ s.heading | escape }}{% if s.heading_outline != blank %}<br><span class="ital">{{ s.heading_outline | escape }}</span>{% endif %}</{{ htag }}>
            {%- if s.text != blank -%}<p class="hero__sub">{{ s.text | escape }}</p>{%- endif -%}
            <div class="hero__cta">
              {%- if s.button_label != blank -%}
                <a class="btn btn--lg" href="{{ s.button_link | default: '#' }}" data-focusable>{{ s.button_label | escape }} {% render 'icon', name: 'arrow-right', size: 18, stroke_width: 2 %}</a>
              {%- endif -%}
              {%- if s.product != blank and s.show_price and show_video == false -%}
                <span class="hero__price">{{ 'general.from' | t }} {{ s.product.price | money }}</span>
              {%- endif -%}
            </div>
          </div>
          <div class="hero__visual{% if show_video %} hero__visual--video{% endif %}" aria-hidden="{% if hero_img != blank or show_video %}false{% else %}true{% endif %}">
            {%- if show_video -%}
              {%- if video_kind == 'file' -%}
                {{- s.video | video_tag: image_size: '1200x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'hero__video' -}}
              {%- elsif video_kind == 'youtube' -%}
                <div class="hero__embed"><iframe src="https://www.youtube.com/embed/{{ s.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ s.video_url.id }}&controls=0&playsinline=1&rel=0&modestbranding=1" title="{{ s.heading | escape }}" loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
              {%- elsif video_kind == 'vimeo' -%}
                <div class="hero__embed"><iframe src="https://player.vimeo.com/video/{{ s.video_url.id }}?background=1&autoplay=1&muted=1&loop=1" title="{{ s.heading | escape }}" loading="lazy" allow="autoplay; picture-in-picture"></iframe></div>
              {%- endif -%}
            {%- elsif hero_img != blank -%}
              {%- if forloop.first -%}
                {{- hero_img | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200', sizes: '(min-width: 990px) 45vw, 90vw', alt: hero_img.alt | default: s.heading -}}
              {%- else -%}
                {{- hero_img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 990px) 45vw, 90vw', alt: hero_img.alt | default: s.heading -}}
              {%- endif -%}
            {%- else -%}
              {% render 'shoe-placeholder', stroke_width: 1.5, opacity: 0.1 %}
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hero__controls" data-controls>
      <div class="container hero__controls-inner">
        <div class="hero__counter" data-counter aria-live="polite">01 / {% if section.blocks.size < 10 %}0{% endif %}{{ section.blocks.size }}</div>
        <div class="hero__bars">
          {%- for block in section.blocks -%}
            <button type="button" class="hero__bar" data-go="{{ forloop.index0 }}" aria-label="{{ 'general.go_to_slide' | t: number: forloop.index }}" {% if forloop.first %}aria-current="true"{% endif %}><span></span></button>
          {%- endfor -%}
        </div>
        <div class="hero__arrows">
          <button type="button" class="hero__arrow" data-prev aria-label="{{ 'general.previous_slide' | t }}">{% render 'icon', name: 'arrow-left', size: 22, stroke_width: 2 %}</button>
          <button type="button" class="hero__arrow" data-next aria-label="{{ 'general.next_slide' | t }}">{% render 'icon', name: 'arrow-right', size: 22, stroke_width: 2 %}</button>
        </div>
      </div>
    </div>
  {%- endif -%}
</hero-slider>

{% stylesheet %}
  .hero__visual--video{display:flex;align-items:center;justify-content:center}
  .hero__visual .hero__video,.hero__visual video{display:block;width:100%;max-height:560px;object-fit:cover;background:#000}
  .hero__embed{position:relative;width:100%;aspect-ratio:16/9;max-height:560px;background:#000;overflow:hidden}
  .hero__embed iframe{position:absolute;inset:0;width:100%;height:100%;border:0;pointer-events:none}
{% endstylesheet %}

{% schema %}
{
  "name": "Hero slider",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Accessible label", "default": "Featured drops" },
    { "type": "range", "id": "height", "label": "Minimum height", "min": 420, "max": 860, "step": 20, "unit": "px", "default": 640 },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "interval", "label": "Change every", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 6 },
    { "type": "checkbox", "id": "show_badge", "label": "Show rotating badge", "default": true },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "AUTHENTIC · GUARANTEED · VERIFIED ·" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "select", "id": "color_scheme", "label": "Color scheme", "default": "grey", "options": [
          { "value": "light", "label": "Light" }, { "value": "grey", "label": "Grey" }, { "value": "dark", "label": "Dark" }
        ] },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Fresh kicks · Fast delivery" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "New drops," },
        { "type": "text", "id": "heading_outline", "label": "Outlined heading text", "default": "landed." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Authentic Nike, ASICS, UGG, Saucony and HOKA, packed properly and out of the door fast." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop new arrivals" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "header", "content": "Slide media" },
        { "type": "product", "id": "product", "label": "Featured product", "info": "Optional. Its image and price are used unless you upload an image below." },
        { "type": "checkbox", "id": "show_price", "label": "Show “From” price", "default": true },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Transparent PNG or WebP of a single shoe works best." },
        { "type": "video", "id": "video", "label": "Video", "info": "Uploaded video. Plays muted, looping and without controls. Shown instead of the image. Remove it to show the image again." },
        { "type": "video_url", "id": "video_url", "label": "Or video link", "accept": ["youtube", "vimeo"], "info": "YouTube or Vimeo link. Used only if no video is uploaded above." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide", "settings": { "color_scheme": "dark", "kicker": "Trending now", "heading": "ASICS", "heading_outline": "Gel-1130", "text": "Dusty Fern Black. Just in and moving fast.", "button_label": "Shop ASICS" } },
        { "type": "slide", "settings": { "color_scheme": "light", "kicker": "Summer sale", "heading": "UGG", "heading_outline": "for less.", "text": "Classic minis, micros and slippers, marked down.", "button_label": "Shop the sale" } }
      ]
    }
  ]
}
{% endschema %}
