{%- liquid
  assign items = product.metafields.shopify--discovery--product_recommendation.complementary_products.value
  assign fallback = section.settings.fallback_collection
  assign shown = 0
-%}
{%- if items != blank or fallback != blank or request.design_mode -%}
<section class="cl" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="d h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="rail cl__rail">
      {%- if items != blank -%}
        {%- for p in items limit: section.settings.max -%}
          {%- assign shown = shown | plus: 1 -%}
          <div class="rail__item cl__item">{% render 'product-card', product: p, compact: true %}</div>
        {%- endfor -%}
      {%- elsif fallback != blank -%}
        {%- for p in fallback.products limit: 12 -%}
          {%- if p.id != product.id and shown < section.settings.max -%}
            {%- assign shown = shown | plus: 1 -%}
            <div class="rail__item cl__item">{% render 'product-card', product: p, compact: true %}</div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <p class="lbl">Set complementary products in the Shopify Search and Discovery app, or choose a fallback collection.</p>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .cl{border-top:1px solid #000}
  .cl__item{width:200px;flex:none}
{% endstylesheet %}

{% schema %}
{
  "name": "Complete the look",
  "settings": [
    { "type": "paragraph", "content": "Uses complementary products from the Shopify Search and Discovery app. Falls back to the collection below." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the look" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Laces, cleaner and care. Added in one tap." },
    { "type": "collection", "id": "fallback_collection", "label": "Fallback collection" },
    { "type": "range", "id": "max", "label": "Products to show", "min": 2, "max": 10, "step": 1, "default": 6 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 }
  ],
  "presets": [{ "name": "Complete the look" }]
}
{% endschema %}
