<section class="cf" id="faq" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="wrap">
    <div class="cf__grid">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="lbl cf__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2 class="d h2 cf__title">{{ section.settings.heading }}</h2>
        <div class="rte cf__about">
          {%- if collection.metafields.custom.about != blank -%}
            {{ collection.metafields.custom.about | metafield_tag }}
          {%- else -%}
            {{ section.settings.about_text }}
          {%- endif -%}
        </div>
      </div>

      <div>
        <div class="lbl cf__eyebrow">{{ section.settings.faq_heading }}</div>
        {%- assign meta_faq = collection.metafields.custom.faq.value -%}
        {%- assign faq_count = 0 -%}
        {%- if meta_faq != blank -%}
          {%- for item in meta_faq -%}
            {%- assign faq_count = faq_count | plus: 1 -%}
            {%- assign ans = item.answer | escape | newline_to_br -%}
            {% render 'faq-item', question: item.question, answer: ans, open: forloop.first %}
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- assign faq_count = faq_count | plus: 1 -%}
            <div {{ block.shopify_attributes }}>
              {% render 'faq-item', question: block.settings.question, answer: block.settings.answer, open: forloop.first %}
            </div>
          {%- endfor -%}
        {%- endif -%}
        {%- if faq_count > 0 -%}<div class="cf__end"></div>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- if faq_count > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- if meta_faq != blank -%}
          {%- for item in meta_faq -%}
            {
              "@type": "Question",
              "name": {{ item.question | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | json }} }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .cf{border-top:1px solid #000}
  .cf__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:72px;align-items:start}
  .cf__eyebrow{margin-bottom:16px}
  .cf__title{margin-bottom:28px}
  .cf__about{max-width:54ch}
  .faq{border-top:1px solid #000;padding:18px 0}
  .faq summary{list-style:none;display:flex;justify-content:space-between;gap:16px;font-weight:600;font-size:18px;cursor:pointer}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary::after{content:'+';font-size:22px;line-height:1}
  .faq[open] summary::after{content:'\2212'}
  .faq__a{margin-top:12px;max-width:56ch;font-size:16px}
  .faq__a p:last-child{margin-bottom:0}
  .cf__end{border-top:1px solid #000}
  @media (max-width:1000px){.cf__grid{grid-template-columns:minmax(0,1fr);gap:40px}}
{% endstylesheet %}

{% schema %}
{
  "name": "About and FAQ",
  "settings": [
    { "type": "paragraph", "content": "For per-collection copy, set the collection metafields custom.about (rich text) and custom.faq (JSON list of question and answer). Otherwise the content below is used. FAQ schema markup for search is generated automatically." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About the silhouette" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What to know before you buy" },
    { "type": "richtext", "id": "about_text", "label": "About text", "default": "<p>Write two or three short paragraphs about the model: what it is, how it fits and who it suits.</p>" },
    { "type": "text", "id": "faq_heading", "label": "FAQ label", "default": "Frequently asked" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Do they fit true to size?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Generally yes. If you are between sizes, most people go up half a size.</p>" }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}
