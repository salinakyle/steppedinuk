<div class="container section" style="--pt:56px;--pb:72px">
  <h1 class="display display-xl" style="margin-bottom:28px">{{ 'customer.register_title' | t }}</h1>
  {%- form 'create_customer', novalidate: 'novalidate' -%}
    <div class="form-stack">
      {%- if form.errors -%}<div class="form-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="RegisterFirst">{{ 'customer.first_name' | t }}</label><input class="input" type="text" name="customer[first_name]" id="RegisterFirst" autocomplete="given-name" value="{{ form.first_name }}"></div>
      <div class="field"><label for="RegisterLast">{{ 'customer.last_name' | t }}</label><input class="input" type="text" name="customer[last_name]" id="RegisterLast" autocomplete="family-name" value="{{ form.last_name }}"></div>
      <div class="field"><label for="RegisterEmail">{{ 'customer.email' | t }}</label><input class="input" type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" value="{{ form.email }}" required></div>
      <div class="field"><label for="RegisterPassword">{{ 'customer.password' | t }}</label><input class="input" type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required></div>
      <button class="btn btn--lg" type="submit" style="justify-self:start">{{ 'customer.create' | t }}</button>
      <a class="link-underline" style="justify-self:start" href="{{ routes.account_login_url }}">{{ 'customer.sign_in' | t }}</a>
    </div>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Register" }
{% endschema %}
