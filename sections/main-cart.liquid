<div class="container section" style="--pt:48px;--pb:72px" data-main-cart>
  <h1 class="display display-xl" style="margin-bottom:32px">{{ 'cart.title' | t }}</h1>
  {%- if cart.item_count == 0 -%}
    <div class="cart-empty" style="text-align:left">
      <p>{{ 'cart.empty' | t }}</p>
      <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
    </div>
  {%- else -%}
    <div class="cart-page">
      <div data-cart-lines>
        {%- for line in cart.items -%}
          {% render 'cart-line', line: line, index: forloop.index %}
        {%- endfor -%}
      </div>
      <form class="cart-summary" action="{{ routes.cart_url }}" method="post">
        {%- if section.settings.show_note -%}
          <div class="field">
            <label for="CartNote">{{ 'cart.note' | t }}</label>
            <textarea class="textarea" id="CartNote" name="note" style="min-height:96px" data-cart-note>{{ cart.note }}</textarea>
          </div>
        {%- endif -%}
        {%- liquid
  assign cyc_cart_pids = cart.items | map: 'product_id'
  assign cyc_first = cart.items.first.product
  assign cyc_colls = cyc_first.collections | sort: 'products_count'
  assign cyc_ids = ''
  assign cyc_n = 0
  for cyc_c in cyc_colls
    if cyc_c.handle == 'all' or cyc_c.handle == 'frontpage' or cyc_c.products_count < 2
      continue
    endif
    assign cyc_cn = 0
    for cyc_p in cyc_c.products limit: 30
      assign cyc_pid = cyc_p.id | append: ''
      assign cyc_key = ',' | append: cyc_pid | append: ','
      assign cyc_hay = ',' | append: cyc_ids
      if cyc_p.available and cyc_p.id != cyc_first.id and cyc_cn < 8
        unless cyc_cart_pids contains cyc_p.id or cyc_hay contains cyc_key
          assign cyc_ids = cyc_ids | append: cyc_pid | append: ','
          assign cyc_n = cyc_n | plus: 1
          assign cyc_cn = cyc_cn | plus: 1
        endunless
      endif
    endfor
    if cyc_n >= 2
      break
    endif
  endfor
  assign cyc_arr = cyc_ids | split: ','
  assign cyc_size = cyc_arr.size
  assign cyc_seed = 'now' | date: '%s' | plus: 0
  assign cyc_done = ','
  if cyc_size > 0
    assign cyc_i1 = cyc_seed | modulo: cyc_size
    assign cyc_i2 = cyc_seed | divided_by: 7 | modulo: cyc_size
    if cyc_i2 == cyc_i1
      assign cyc_i2 = cyc_i1 | plus: 1 | modulo: cyc_size
    endif
    assign cyc_pick1 = cyc_arr[cyc_i1]
    assign cyc_pick2 = cyc_arr[cyc_i2]
  endif
-%}
{%- if cyc_size > 0 -%}
  <div class="complete-collection" style="margin:0 0 20px;padding:0 0 16px;border-bottom:1px solid var(--color-border,#e5e5e5)">
    <h3 style="font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin:0 0 12px">Complete your collection</h3>
    {%- for cyc_c in cyc_colls -%}
      {%- if cyc_c.handle == 'all' or cyc_c.handle == 'frontpage' or cyc_c.products_count < 2 -%}{%- continue -%}{%- endif -%}
      {%- for cyc_p in cyc_c.products limit: 30 -%}
        {%- assign cyc_pid = cyc_p.id | append: '' -%}
        {%- assign cyc_key = ',' | append: cyc_pid | append: ',' -%}
        {%- if cyc_pid == cyc_pick1 or cyc_pid == cyc_pick2 -%}
          {%- unless cyc_done contains cyc_key -%}
            {%- assign cyc_done = cyc_done | append: cyc_pid | append: ',' -%}
            {%- assign cyc_v = cyc_p.selected_or_first_available_variant -%}
            <div class="complete-collection__item" style="display:flex;align-items:center;gap:12px;margin-bottom:12px">
              <a href="{{ cyc_p.url }}" style="flex:0 0 64px;width:64px;height:64px;display:block;background:#f4f4f4;overflow:hidden">
                {%- if cyc_p.featured_image -%}
                  <img src="{{ cyc_p.featured_image | image_url: width: 160 }}" alt="{{ cyc_p.featured_image.alt | default: cyc_p.title | escape }}" width="64" height="64" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block">
                {%- endif -%}
              </a>
              <div style="flex:1;min-width:0">
                <a href="{{ cyc_p.url }}" style="font-size:13px;font-weight:600;line-height:1.3;color:inherit;text-decoration:none;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical">{{ cyc_p.title }}</a>
                <span style="display:block;font-size:13px;margin-top:2px">{{ cyc_v.price | money }}</span>
              </div>
              <button type="button" data-quick-add="{{ cyc_v.id }}" class="btn btn--sm" style="flex:0 0 auto;padding:8px 18px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;background:var(--color-text,#000);color:var(--color-bg,#fff);border:1px solid var(--color-text,#000);cursor:pointer">Add</button>
            </div>
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
{%- endif -%}

        {%- for discount in cart.cart_level_discount_applications -%}
          <div style="display:flex;justify-content:space-between;font-size:14px"><span>{{ discount.title | escape }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
        {%- endfor -%}
        <div class="cart-summary__row"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money_with_currency }}</span></div>
        <p style="color:var(--color-muted);font-size:14px">{{ 'cart.taxes_shipping' | t }}</p>
        <button type="submit" name="checkout" class="btn btn--lg btn--full">{{ 'cart.checkout' | t }}</button>
        <a href="{{ routes.all_products_collection_url }}" class="link-underline" style="justify-self:center">{{ 'cart.continue' | t }}</a>
      </form>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Show order note", "default": false }
  ]
}
{% endschema %}
