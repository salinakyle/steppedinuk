<section class="scheme-{{ section.settings.color_scheme }}" style="margin-top:{{ section.settings.margin_top }}px">
  <div class="container society__grid">
    <div>
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow" style="color:var(--s-text)">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
      <h2 class="display" style="margin-top:12px;font-size:clamp(52px,7vw,104px);line-height:.88">{{ section.settings.heading | escape }}{% if section.settings.heading_outline != blank %} <span class="ital">{{ section.settings.heading_outline | escape }}</span>{% endif %}</h2>
      <ul class="perks">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="perks__tick" aria-hidden="true">{% render 'icon', name: 'check', size: 16, stroke_width: 3 %}</span>
            {{ block.settings.text | escape }}
          </li>
        {%- endfor -%}
      </ul>
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--lg" href="{{ section.settings.button_link | default: routes.account_register_url }}">{{ section.settings.button_label | escape }} →</a>
      {%- endif -%}
    </div>
    <div class="society__media">
      {%- if section.settings.image != blank -%}
        {{- section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 750, 1000', sizes: '(min-width: 990px) 45vw, 90vw', alt: section.settings.image.alt | default: section.settings.heading -}}
      {%- else -%}
        {% render 'shoe-placeholder', stroke_width: 1.4, opacity: 0.06 %}
        <span class="placeholder-note" style="left:16px;right:auto;bottom:14px">Photo: [warehouse / packing shot]</span>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Membership / feature list",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "default": "dark", "options": [
      { "value": "light", "label": "Light" }, { "value": "grey", "label": "Grey" }, { "value": "dark", "label": "Dark" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A curated sneaker destination" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome to the Stepped In" },
    { "type": "text", "id": "heading_outline", "label": "Outlined heading text", "default": "Society" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the Society" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "margin_top", "label": "Space above", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    { "type": "perk", "name": "Perk", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Professional packaging on every pair" } ] }
  ],
  "presets": [
    {
      "name": "Membership / feature list",
      "blocks": [
        { "type": "perk", "settings": { "text": "Professional packaging on every pair" } },
        { "type": "perk", "settings": { "text": "Priority dispatch" } },
        { "type": "perk", "settings": { "text": "Early access to drops" } }
      ]
    }
  ]
}
{% endschema %}
