<section class="linkrows" style="padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px" aria-labelledby="LinkMarquee-{{ section.id }}">
  <div class="container">
    <h2 id="LinkMarquee-{{ section.id }}" class="display display-lg" style="margin-bottom:20px">{{ section.settings.heading | escape }}{% if section.settings.heading_outline != blank %} <span class="ital">{{ section.settings.heading_outline | escape }}</span>{% endif %}</h2>
  </div>
  {%- for row in (1..2) -%}
    {%- assign has_links = false -%}
    {%- for block in section.blocks -%}
      {%- assign probe_row = block.settings.row | plus: 0 -%}
      {%- if probe_row == row -%}{%- assign has_links = true -%}{%- endif -%}
    {%- endfor -%}
    {%- if has_links -%}
      <div class="fade">
        <div class="fade__track {% if row == 2 %}fade__track--rev{% endif %}">
          {%- for copy in (1..2) -%}
            <div class="fade__group" {% if copy == 2 %}aria-hidden="true"{% endif %}>
              {%- for block in section.blocks -%}
                {%- assign block_row = block.settings.row | plus: 0 -%}
                {%- if block_row == row -%}
                  <a class="plink" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {% if copy == 2 %}tabindex="-1"{% else %}{{ block.shopify_attributes }}{% endif %}>{{ block.settings.label | escape }}</a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Popular links",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Popular" },
    { "type": "text", "id": "heading_outline", "label": "Outlined heading text", "default": "now" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Nike P-6000" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "row", "label": "Row", "default": "1", "options": [ { "value": "1", "label": "Row 1 (scrolls left)" }, { "value": "2", "label": "Row 2 (scrolls right)" } ] }
      ]
    }
  ],
  "presets": [
    {
      "name": "Popular links",
      "blocks": [
        { "type": "link", "settings": { "label": "Nike P-6000", "row": "1" } },
        { "type": "link", "settings": { "label": "ASICS Gel-1130", "row": "1" } },
        { "type": "link", "settings": { "label": "UGG Classic Ultra Mini", "row": "1" } },
        { "type": "link", "settings": { "label": "HOKA Clifton", "row": "1" } },
        { "type": "link", "settings": { "label": "Air Jordan 1", "row": "1" } },
        { "type": "link", "settings": { "label": "Nike Air Max Plus Tuned 1", "row": "2" } },
        { "type": "link", "settings": { "label": "Pokémon Booster Bundle", "row": "2" } },
        { "type": "link", "settings": { "label": "UGG Goldenstar Clog", "row": "2" } },
        { "type": "link", "settings": { "label": "ASICS Gel-NYC", "row": "2" } },
        { "type": "link", "settings": { "label": "Air Max 1", "row": "2" } }
      ]
    }
  ]
}
{% endschema %}
