<section class="hub" style="padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="wrap">
    {%- if section.settings.show_breadcrumb -%}
      <nav class="lbl hub__crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a> / <a href="{{ routes.collections_url }}">Collections</a> / <span>{{ collection.title }}</span>
      </nav>
    {%- endif -%}
    <div class="hub__grid">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="lbl hub__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h1 class="d hub__title">{{ collection.title }}</h1>
      </div>
      <div class="hub__intro">
        {%- if collection.metafields.custom.intro != blank -%}
          <div class="rte">{{ collection.metafields.custom.intro | metafield_tag }}</div>
        {%- elsif collection.description != blank -%}
          <div class="rte">{{ collection.description }}</div>
        {%- endif -%}
        {%- if section.settings.faq_link_label != blank -%}
          <a href="#faq" class="lbl u">{{ section.settings.faq_link_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .hub{border-bottom:1px solid #000;padding-top:20px}
  .hub__crumbs{margin-bottom:36px}
  .hub__crumbs a:hover{text-decoration:underline}
  .hub__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:72px;align-items:end}
  .hub__eyebrow{margin-bottom:16px}
  .hub__title{font-size:clamp(52px,8vw,120px)}
  .hub__intro .rte{margin-bottom:12px;max-width:52ch}
  @media (max-width:1000px){.hub__grid{grid-template-columns:minmax(0,1fr);gap:24px}.hub__crumbs{margin-bottom:20px}}
{% endstylesheet %}

{% schema %}
{
  "name": "Collection header",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Silhouette hub" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "faq_link_label", "label": "Link to FAQ", "default": "Sizing, fit and FAQs", "info": "Leave blank to hide. Points at the FAQ section on the same page." },
    { "type": "paragraph", "content": "Intro copy comes from the collection description, or the metafield custom.intro if set." },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 48 }
  ]
}
{% endschema %}
