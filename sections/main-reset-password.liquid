<div class="container section" style="--pt:56px;--pb:72px">
  <h1 class="display display-xl" style="margin-bottom:28px">{{ 'customer.reset_password_title' | t }}</h1>
  <p style="margin-bottom:20px">{{ 'customer.reset_password_text' | t: email: email }}</p>
  {%- form 'reset_customer_password' -%}
    <div class="form-stack">
      {%- if form.errors -%}<div class="form-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ResetPassword">{{ 'customer.password' | t }}</label><input class="input" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required></div>
      <div class="field"><label for="ResetPasswordConfirm">{{ 'customer.password_confirm' | t }}</label><input class="input" type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required></div>
      <button class="btn btn--lg" type="submit" style="justify-self:start">{{ 'customer.reset_password_submit' | t }}</button>
    </div>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Reset password" }
{% endschema %}
