{%- liquid
  assign now_num = 'now' | date: '%s' | plus: 0
  assign drop_ts = section.settings.drop_time | date: '%s' | plus: 0
  assign upcoming = false
  if section.settings.drop_time != blank and drop_ts > now_num
    assign upcoming = true
  endif
-%}
<section class="society dark" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px" aria-labelledby="society-{{ section.id }}">
  <div class="wrap society__grid">
    <div>
      <div class="lbl society__eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="d society__title" id="society-{{ section.id }}">{{ section.settings.heading }}</h2>
      <p class="society__text">{{ section.settings.text }}</p>
      <ul class="society__list" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}><span class="lbl">{{ forloop.index | prepend: '0' }}</span><span>{{ block.settings.text }}</span></li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="society__card">
      {%- if upcoming -%}
        <div class="lbl society__eyebrow">Next member drop</div>
        <div class="d society__drop">{{ section.settings.drop_title }}</div>
        <div class="society__cd" data-countdown-wrap>
          <div class="society__cd-grid" data-countdown="{{ section.settings.drop_time | date: '%Y-%m-%dT%H:%M:%S%:z' }}" role="timer" aria-label="Time until next member drop">
            <div><div class="d society__n" data-cd-d>00</div><div class="lbl">Days</div></div>
            <div><div class="d society__n" data-cd-h>00</div><div class="lbl">Hrs</div></div>
            <div><div class="d society__n" data-cd-m>00</div><div class="lbl">Min</div></div>
            <div><div class="d society__n" data-cd-s>00</div><div class="lbl">Sec</div></div>
          </div>
        </div>
      {%- else -%}
        <div class="d society__drop">{{ section.settings.no_drop_text }}</div>
      {%- endif -%}

      {%- form 'customer', id: 'society-form', class: 'society__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="society__ok" role="status">{{ section.settings.success_text }}</p>
        {%- else -%}
          <input type="hidden" name="contact[tags]" value="{{ section.settings.tag }}">
          <label for="society-email-{{ section.id }}" class="lbl">Email address</label>
          <div class="society__row">
            <input id="society-email-{{ section.id }}" class="field" type="email" name="contact[email]" placeholder="you@email.com" autocomplete="email" required>
            <button type="submit" class="btn">{{ section.settings.button_label }}</button>
          </div>
          {%- if form.errors -%}
            <div class="form-error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <p class="society__fine">{{ section.settings.fine_print }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .society__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:72px;align-items:start}
  .society__eyebrow{margin-bottom:20px}
  .society__title{font-size:clamp(40px,5.4vw,80px);margin-bottom:24px}
  .society__text{margin:0 0 32px;font-size:17px;max-width:44ch}
  .society__list{list-style:none;margin:0;padding:0;border-bottom:1px solid #fff}
  .society__list li{display:flex;gap:20px;padding:16px 0;border-top:1px solid #fff}
  .society__list .lbl{width:24px;flex:none;padding-top:4px}
  .society__card{border:1px solid #fff;padding:32px}
  .society__drop{font-size:34px;margin-bottom:24px}
  .society__cd-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border:1px solid #fff;margin-bottom:28px}
  .society__cd-grid>div{padding:14px 12px}
  .society__cd-grid>div+div{border-left:1px solid #fff}
  .society__n{font-size:40px;margin-bottom:6px}
  .society__form label{display:block;margin-bottom:10px}
  .society__row{display:flex;gap:8px;flex-wrap:wrap}
  .society__row .field{flex:1;min-width:200px}
  .society__fine{margin:14px 0 0;font-size:13px}
  .society__ok{margin:0;font-weight:600;font-size:18px}
  @media (max-width:1000px){
    .society__grid{grid-template-columns:minmax(0,1fr);gap:40px}
    .society__card{padding:20px}
    .society__n{font-size:30px}
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Society",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SteppedIn Society" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "First in line. Every drop." },
    { "type": "textarea", "id": "text", "label": "Pitch", "default": "Free to join. Members get early access windows, size-specific restock alerts and the occasional pair we hold back for them." },
    { "type": "header", "content": "Next drop countdown" },
    { "type": "text", "id": "drop_title", "label": "Next drop name", "default": "New Balance 550" },
    { "type": "text", "id": "drop_time", "label": "Next drop date and time", "info": "ISO format with offset, e.g. 2026-10-24T10:00:00+01:00. Countdown hides itself when blank or in the past." },
    { "type": "text", "id": "no_drop_text", "label": "Text when no drop is scheduled", "default": "The next drop is coming. Join to hear first." },
    { "type": "header", "content": "Email capture" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join Society" },
    { "type": "text", "id": "tag", "label": "Customer tag", "default": "society", "info": "Added to every sign-up so you can segment in Shopify, Klaviyo or Flow." },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "You are in. Watch your inbox for the next drop." },
    { "type": "text", "id": "fine_print", "label": "Small print", "default": "Free to join. Unsubscribe at any time." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "text", "label": "Benefit", "default": "Early access before general release" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Society",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Early access before general release" } },
        { "type": "benefit", "settings": { "text": "Alerts only for your size, never the whole range" } },
        { "type": "benefit", "settings": { "text": "Member-only drops, held for 24 hours" } }
      ]
    }
  ]
}
{% endschema %}
