<product-tabs class="container section" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px;--cols:{{ section.settings.columns }}">
  <div class="sec-head">
    <h2 class="display display-xl">{{ section.settings.heading | escape }}{% if section.settings.heading_outline != blank %} <span class="ital">{{ section.settings.heading_outline | escape }}</span>{% endif %}</h2>
    <div class="tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
      {%- for block in section.blocks -%}
        <button type="button" class="tab" role="tab" id="tab-{{ section.id }}-{{ forloop.index }}" aria-controls="panel-{{ section.id }}-{{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" data-tab {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title | escape }}</button>
      {%- endfor -%}
    </div>
  </div>

  {%- for block in section.blocks -%}
    <div class="tab-panel" role="tabpanel" id="panel-{{ section.id }}-{{ forloop.index }}" aria-labelledby="tab-{{ section.id }}-{{ forloop.index }}" {% unless forloop.first %}hidden{% endunless %}>
      <div class="grid-products {% if section.settings.mobile_carousel %}grid-products--carousel{% endif %}">
        {%- if block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
          {%- for product in block.settings.collection.products limit: section.settings.count -%}
            {% render 'product-card', product: product, show_new: false %}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}{% render 'product-card', product: blank %}{%- endfor -%}
        {%- endif -%}
      </div>
      {%- if block.settings.collection != blank -%}
        <div class="center-cta">
          <a class="btn btn--outline" href="{{ block.settings.collection.url }}">{{ 'general.browse_collection' | t: title: block.settings.collection.title }} →</a>
        </div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</product-tabs>

{% schema %}
{
  "name": "Product tabs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by" },
    { "type": "text", "id": "heading_outline", "label": "Outlined heading text", "default": "brand" },
    { "type": "range", "id": "count", "label": "Products per tab", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "mobile_carousel", "label": "Swipeable carousel on mobile", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "info": "Defaults to the collection title." },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "Sale" } },
        { "type": "tab", "settings": { "label": "Nike" } },
        { "type": "tab", "settings": { "label": "ASICS" } },
        { "type": "tab", "settings": { "label": "UGG" } }
      ]
    }
  ]
}
{% endschema %}
