<div class="password-page">
  <div class="box">
    <a class="logo" href="{{ routes.root_url }}" style="font-size:44px">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: loading: 'eager', alt: shop.name }}
      {%- else -%}
        <span>{{ section.settings.logo_text_1 | escape }}</span>{% if section.settings.logo_text_2 != blank %}<span class="logo__tag">{{ section.settings.logo_text_2 | escape }}</span>{% endif %}
      {%- endif -%}
    </a>
    <h1 class="display display-xl">{{ section.settings.heading | escape }}{% if section.settings.heading_outline != blank %} <span class="ital">{{ section.settings.heading_outline | escape }}</span>{% endif %}</h1>
    {%- if shop.password_message != blank -%}<div class="rte" style="font-size:18px">{{ shop.password_message }}</div>{%- endif -%}

    {%- form 'customer', id: 'PasswordNewsletter' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <div class="form-message" role="status">{{ 'newsletter.success' | t }}</div>
      {%- else -%}
        {%- if form.errors -%}<div class="form-error" role="alert" style="margin-bottom:12px">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field">
          <label for="PasswordNewsletterEmail">{{ 'newsletter.label' | t }}</label>
          <div class="newsletter__form">
            <input id="PasswordNewsletterEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}">
            <button type="submit" class="btn">{{ 'newsletter.subscribe' | t }}</button>
          </div>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details>
      <summary class="link-underline" style="cursor:pointer;list-style:none">{{ 'general.password_enter' | t }}</summary>
      {%- form 'storefront_password', novalidate: 'novalidate' -%}
        <div class="form-stack" style="margin-top:16px">
          {%- if form.errors -%}<div class="form-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="field"><label for="StorefrontPassword">{{ 'customer.password' | t }}</label><input class="input" type="password" name="password" id="StorefrontPassword" autocomplete="current-password" required></div>
          <button class="btn" type="submit" style="justify-self:start">{{ 'general.password_submit' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "text", "id": "logo_text_1", "label": "Logo text", "default": "Stepped" },
    { "type": "text", "id": "logo_text_2", "label": "Highlighted logo text", "default": "In" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening" },
    { "type": "text", "id": "heading_outline", "label": "Outlined heading text", "default": "soon." }
  ]
}
{% endschema %}
