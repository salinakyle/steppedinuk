<section class="pw">
  <div class="wrap pw__in">
    <div class="d pw__logo">{{ shop.name }}</div>
    <h1 class="d h1">{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    {%- form 'customer', class: 'pw__form' -%}
      {%- if form.posted_successfully? -%}<p><strong>Thanks. We will be in touch.</strong></p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="prelaunch">
        <input class="field" type="email" name="contact[email]" required placeholder="Email address" aria-label="Email address">
        <button class="btn" type="submit">Notify me</button>
      {%- endif -%}
    {%- endform -%}
    <details class="pw__enter"><summary class="lbl">Enter with password</summary>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <input class="field" type="password" name="password" required aria-label="Password" placeholder="Password">
        <button class="btn btn--w" type="submit">Enter</button>
      {%- endform -%}
    </details>
  </div>
</section>
{% stylesheet %}.pw{min-height:100vh;display:grid;align-items:center;padding:48px 0}.pw__in{max-width:560px}.pw__logo{font-size:28px;font-weight:800;margin-bottom:56px}.pw h1{margin-bottom:12px}.pw__form,.pw__enter form{display:flex;gap:8px;margin-top:24px}.pw__enter{margin-top:48px}.pw__enter summary{cursor:pointer}{% endstylesheet %}
{% schema %}
{ "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    { "type": "text", "id": "text", "label": "Text", "default": "Leave your email and be first to know." }
  ] }
{% endschema %}
