<div class="scheme-{{ section.settings.color_scheme }}">
  <div class="container section" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
    <div class="rich {% if section.settings.center %}rich--center{% endif %}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}<div class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</div>
          {%- when 'heading' -%}<h2 class="display display-{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}{% if block.settings.outline != blank %} <span class="ital">{{ block.settings.outline | escape }}</span>{% endif %}</h2>
          {%- when 'text' -%}<div class="rte" style="font-size:18px;line-height:1.55" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            {%- if block.settings.label != blank -%}<a class="btn {% if block.settings.outline_style %}btn--outline{% endif %}" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>{%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "default": "light", "options": [
      { "value": "light", "label": "Light" }, { "value": "grey", "label": "Grey" }, { "value": "dark", "label": "Dark" }
    ] },
    { "type": "checkbox", "id": "center", "label": "Center content", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Eyebrow", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Our story" } ] },
    { "type": "heading", "name": "Heading", "settings": [
      { "type": "text", "id": "text", "label": "Heading", "default": "Authentic sneakers," },
      { "type": "text", "id": "outline", "label": "Outlined text", "default": "delivered." },
      { "type": "select", "id": "size", "label": "Size", "default": "lg", "options": [ { "value": "xl", "label": "Large" }, { "value": "lg", "label": "Medium" }, { "value": "md", "label": "Small" } ] }
    ] },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell customers about your shop.</p>" } ] },
    { "type": "button", "name": "Button", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Shop now" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "checkbox", "id": "outline_style", "label": "Outline style", "default": false }
    ] }
  ],
  "presets": [
    { "name": "Rich text", "blocks": [ { "type": "eyebrow" }, { "type": "heading" }, { "type": "text" }, { "type": "button" } ] }
  ]
}
{% endschema %}
