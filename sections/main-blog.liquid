<section class="mb" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="wrap">
    <h1 class="d h1">{{ blog.title }}</h1>
    {%- paginate blog.articles by 9 -%}
      <div class="grid grid--3 mb__grid">
        {%- for article in blog.articles -%}
          <article>
            <a href="{{ article.url }}" class="ph mb__img" style="aspect-ratio:3/2;display:block">
              {%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 800', sizes: '(min-width: 1000px) 30vw, 100vw', alt: article.image.alt | default: article.title }}{%- else -%}{{ 'collection-2' | placeholder_svg_tag }}{%- endif -%}
            </a>
            <div class="lbl" style="margin-top:14px">{{ article.published_at | date: '%-d %B %Y' }}</div>
            <h2 class="d mb__t"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
          </article>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="ms__pages" aria-label="Pagination" style="display:flex;gap:16px;justify-content:center;align-items:center;margin-top:48px">
          {%- if paginate.previous -%}<a class="pill" href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
          <span class="lbl">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a class="pill" href="{{ paginate.next.url }}">Next</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% stylesheet %}.mb h1{margin-bottom:32px}.mb__grid{gap:40px 24px}.mb__img img{width:100%;height:100%;object-fit:cover;display:block}.mb__t{font-size:22px;font-weight:700;margin:6px 0 8px}.mb__t a:hover{text-decoration:underline}{% endstylesheet %}
{% schema %}
{ "name": "Blog", "settings": [ { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 } ] }
{% endschema %}
