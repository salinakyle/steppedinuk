<article class="ma" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="wrap ma__in">
    <div class="lbl">{{ article.published_at | date: '%-d %B %Y' }}{% if article.author %} · {{ article.author }}{% endif %}</div>
    <h1 class="d h1">{{ article.title }}</h1>
    {%- if article.image -%}<div class="ph ma__img">{{ article.image | image_url: width: 1400 | image_tag: widths: '700, 1000, 1400', sizes: '(min-width: 800px) 760px, 100vw', alt: article.image.alt | default: article.title }}</div>{%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <a class="pill" href="{{ blog.url }}">Back to {{ blog.title }}</a>
  </div>
</article>
{% stylesheet %}.ma__in{max-width:760px}.ma h1{margin:12px 0 28px}.ma__img{margin-bottom:32px}.ma__img img{width:100%;height:auto;display:block}.ma .rte{margin-bottom:40px}{% endstylesheet %}
{% schema %}
{ "name": "Article", "settings": [ { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 } ] }
{% endschema %}
