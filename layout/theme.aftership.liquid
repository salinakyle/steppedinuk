{% endcomment %}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_dark_bg }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {%- assign tags_joined = current_tags | join: ', ' -%}
  <title>{{ page_title }}{% if current_tags %} &ndash; {{ 'general.tagged' | t: tags: tags_joined }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: number: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}

  {% render 'meta-tags' %}
  {% render 'head-assets' %}

  <script>
    window.theme = {
      routes: {
        root: {{ routes.root_url | json }},
        cart: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | json }},
        cartChange: {{ routes.cart_change_url | json }},
        cartUpdate: {{ routes.cart_update_url | json }},
        search: {{ routes.search_url | json }},
        predictiveSearch: {{ routes.predictive_search_url | json }}
      },
      cartType: {{ settings.cart_type | json }},
      template: {{ template.name | json }},
      strings: {
        error: {{ 'general.error' | t | json }},
        adding: {{ 'product.adding' | t | json }},
        added: {{ 'product.added' | t | json }},
        readMore: {{ 'general.read_more' | t | json }},
        readLess: {{ 'general.read_less' | t | json }},
        noCountryResults: {{ 'header.no_countries' | t | json }},
        countdownDone: {{ 'product.dispatch_tomorrow' | t | json }}
      }
    };
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <style id="product-carousel-css">
/* Product carousels: draggable + arrows (all breakpoints) */
.carousel{position:relative}
.grid-products--carousel{display:flex!important;grid-template-columns:none;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;gap:20px;margin-right:0;padding-right:0;scrollbar-width:none;cursor:grab;-webkit-overflow-scrolling:touch}
.grid-products--carousel::-webkit-scrollbar{display:none}
.grid-products--carousel>*{flex:0 0 calc((100% - (var(--cols,4) - 1)*20px)/var(--cols,4));min-width:0;scroll-snap-align:start}
.grid-products--carousel img{-webkit-user-drag:none;user-select:none}
.grid-products--carousel.is-dragging{cursor:grabbing;scroll-snap-type:none;scroll-behavior:auto;user-select:none}
.grid-products--carousel.is-dragging a{pointer-events:none}
.carousel__btn{position:absolute;top:35%;transform:translateY(-50%);z-index:3;width:44px;height:44px;border-radius:50%;border:1px solid currentColor;background:#fff;color:#111;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0;box-shadow:0 2px 10px rgba(0,0,0,.15);transition:opacity .2s,transform .2s}
.carousel__btn:hover{transform:translateY(-50%) scale(1.08)}
.carousel__btn--prev{left:-14px}
.carousel__btn--next{right:-14px}
.carousel__btn[disabled]{opacity:0;pointer-events:none}
.carousel__btn svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
@media (max-width:989px){.grid-products--carousel>*{flex-basis:calc((100% - 2*20px)/3)}}
@media (max-width:749px){
.grid-products--carousel{gap:12px}
.grid-products--carousel>*{flex:0 0 72%}
.carousel__btn{width:36px;height:36px}
.carousel__btn--prev{left:4px}.carousel__btn--next{right:4px}
}
</style>
<script id="product-carousel-js">
(() => {
'use strict';
const ARROW = (d) => '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="' + (d < 0 ? 'M15 5l-7 7 7 7' : 'M9 5l7 7-7 7') + '"/></svg>';
function init(track) {
if (track.dataset.carouselReady || track.closest('[data-collection-swap="results"]')) return;
track.dataset.carouselReady = '1';
track.classList.add('grid-products--carousel');
const wrap = document.createElement('div');
wrap.className = 'carousel';
track.parentNode.insertBefore(wrap, track);
wrap.appendChild(track);
const mk = (dir, label) => {
const b = document.createElement('button');
b.type = 'button';
b.className = 'carousel__btn carousel__btn--' + (dir < 0 ? 'prev' : 'next');
b.setAttribute('aria-label', label);
b.innerHTML = ARROW(dir);
b.addEventListener('click', () => {
const item = track.firstElementChild;
const step = item ? item.getBoundingClientRect().width + 20 : track.clientWidth * 0.8;
const n = Math.max(1, Math.floor(track.clientWidth / step));
track.scrollBy({ left: dir * step * n, behavior: 'smooth' });
});
wrap.appendChild(b);
return b;
};
const prev = mk(-1, 'Previous products');
const next = mk(1, 'Next products');
const update = () => {
const max = track.scrollWidth - track.clientWidth - 2;
prev.disabled = track.scrollLeft <= 2;
next.disabled = track.scrollLeft >= max;
if (max <= 0) { prev.disabled = true; next.disabled = true; }
};
track.addEventListener('scroll', update, { passive: true });
window.addEventListener('resize', update);
if ('ResizeObserver' in window) new ResizeObserver(update).observe(track);
update();
let down = false, moved = false, startX = 0, startLeft = 0;
track.addEventListener('mousedown', (e) => {
if (e.button !== 0) return;
down = true; moved = false; startX = e.pageX; startLeft = track.scrollLeft;
});
window.addEventListener('mousemove', (e) => {
if (!down) return;
const dx = e.pageX - startX;
if (!moved && Math.abs(dx) > 5) { moved = true; track.classList.add('is-dragging'); }
if (moved) { e.preventDefault(); track.scrollLeft = startLeft - dx; }
});
const end = () => {
if (!down) return;
down = false;
if (moved) {
track.classList.remove('is-dragging');
const item = track.firstElementChild;
if (item) {
const w = item.getBoundingClientRect().width + 20;
track.scrollTo({ left: Math.round(track.scrollLeft / w) * w, behavior: 'smooth' });
}
}
};
window.addEventListener('mouseup', end);
track.addEventListener('dragstart', (e) => e.preventDefault());
track.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
}
const run = (root) => (root || document).querySelectorAll('.grid-products').forEach(init);
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => run());
else run();
document.addEventListener('shopify:section:load', (e) => run(e.target));
new MutationObserver(() => run()).observe(document.documentElement, { childList: true, subtree: true });
})();
</script>

  {{ content_for_header }}
</head>

<body class="template-{{ template.name | handleize }}"><div class="page-builder-container">{{ content_for_layout }}</div></body>
</html>
