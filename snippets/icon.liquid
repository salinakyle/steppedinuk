{%- comment -%}
  Inline stroke icons.
  Usage: {% render 'icon', name: 'cart', size: 22 %}
  Optional: stroke_width, class
{%- endcomment -%}
{%- liquid
  assign s = size | default: 22
  assign sw = stroke_width | default: 1.8
-%}
{%- if name == 'star' -%}
<svg class="icon icon-star {{ class }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2l3 7 7 .6-5.3 4.7 1.6 7.2L12 17.8 5.7 21.5l1.6-7.2L2 9.6 9 9z"/></svg>
{%- else -%}
<svg class="icon icon-{{ name }} {{ class }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'menu' -%}<path d="M3 7h18M3 17h18"/>
    {%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>
    {%- when 'user' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4.5-6 8-6s7 2 8 6"/>
    {%- when 'cart' -%}<path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 016 0v2"/>
    {%- when 'globe' -%}<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"/>
    {%- when 'close' -%}<path d="M5 5l14 14M19 5L5 19"/>
    {%- when 'arrow-right' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'arrow-left' -%}<path d="M19 12H5M11 6l-6 6 6 6"/>
    {%- when 'arrow-up-right' -%}<path d="M7 17L17 7M9 7h8v8"/>
    {%- when 'chevron-left' -%}<path d="M15 5l-7 7 7 7"/>
    {%- when 'chevron-right' -%}<path d="M9 5l7 7-7 7"/>
    {%- when 'chevron-down' -%}<path d="M5 9l7 7 7-7"/>
    {%- when 'heart' -%}<path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z"/>
    {%- when 'check' -%}<path d="M5 12l5 5 9-10"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'zoom' -%}<circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4M11 8v6M8 11h6"/>
    {%- when 'filter' -%}<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>
    {%- when 'clock' -%}<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2M9 2h6"/>
    {%- when 'calendar' -%}<rect x="3" y="5" width="18" height="16"/><path d="M3 10h18M8 3v4M16 3v4"/>
    {%- when 'delivery' -%}<path d="M3 7h11v9H3zM14 10h4l3 3v3h-7M7 19a2 2 0 100-4 2 2 0 000 4zM17 19a2 2 0 100-4 2 2 0 000 4z"/>
    {%- when 'returns' -%}<path d="M3 12a9 9 0 109-9 9 9 0 00-6.4 2.6L3 8M3 3v5h5"/>
    {%- when 'authentic' -%}<path d="M12 3l8 3v6c0 4.5-3.2 7.6-8 9-4.8-1.4-8-4.5-8-9V6l8-3zM8.5 12l2.5 2.5 4.5-5"/>
    {%- when 'secure' -%}<path d="M6 11h12v9H6zM8 11V8a4 4 0 018 0v3"/>
    {%- when 'card' -%}<path d="M3 6h18v12H3zM3 10h18M7 15h4"/>
    {%- when 'worldwide' -%}<path d="M12 3a9 9 0 100 18 9 9 0 000-18zM3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"/>
    {%- when 'star-outline' -%}<path d="M12 3l2.7 5.8 6.3.7-4.7 4.3 1.3 6.2L12 17l-5.6 3 1.3-6.2L3 9.5l6.3-.7z"/>
    {%- when 'box' -%}<path d="M3 8l9-5 9 5v8l-9 5-9-5V8zM3 8l9 5 9-5M12 13v8"/>
    {%- when 'eye' -%}<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>
    {%- when 'instagram' -%}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/>
    {%- when 'facebook' -%}<path d="M14 8h3V4h-3a4 4 0 00-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"/>
    {%- when 'tiktok' -%}<path d="M14 3v11.5a3.5 3.5 0 11-3.5-3.5M14 3c.3 2.5 2 4.2 5 4.5"/>
    {%- when 'youtube' -%}<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9.5v5l4.5-2.5z"/>
    {%- when 'x' -%}<path d="M4 4l16 16M20 4L4 20"/>
    {%- when 'pinterest' -%}<circle cx="12" cy="12" r="9"/><path d="M11 9c2-1 4 0 4 2 0 2-1 4-3 4M10 17l2-9"/>
    {%- else -%}<circle cx="12" cy="12" r="9"/>
  {%- endcase -%}
</svg>
{%- endif -%}
