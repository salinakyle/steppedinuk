{%- comment -%} Param: paginate (the `paginate` object) {%- endcomment -%}
{%- if paginate.pages > 1 -%}
<nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
  {%- if paginate.previous -%}
    <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">{% render 'icon', name: 'chevron-left', size: 18 %}</a>
  {%- endif -%}
  {%- for part in paginate.parts -%}
    {%- if part.is_link -%}
      <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
    {%- elsif part.title == paginate.current_page -%}
      <span class="is-current" aria-current="page">{{ part.title }}</span>
    {%- else -%}
      <span class="is-gap">{{ part.title }}</span>
    {%- endif -%}
  {%- endfor -%}
  {%- if paginate.next -%}
    <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">{% render 'icon', name: 'chevron-right', size: 18 %}</a>
  {%- endif -%}
</nav>
{%- endif -%}
