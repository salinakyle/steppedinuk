{%- comment -%}
  Product card with swipeable gallery, wishlist heart, badges and quick add.
  Params:
    product       – product object (blank renders an on-brand placeholder card)
    quick_add     – bool, show size picker / add button (default true)
    show_new      – bool, label products published in the last N days as "New"
    new_days      – number of days a product counts as new (default 30)
    eager         – bool, load first image eagerly
    sizes         – img sizes attribute
{%- endcomment -%}
{%- liquid
  assign qa = quick_add
  if qa == nil
    assign qa = true
  endif
  assign img_sizes = sizes | default: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
-%}
{%- if product == blank -%}
  <article class="card card--placeholder">
    <div class="card__media">
      <div class="card__track"><div class="card__slide" style="color:#000">{% render 'shoe-placeholder' %}</div></div>
    </div>
    <div class="card__info">
      <div class="card__vendor">{{ 'general.brand_placeholder' | t }}</div>
      <div class="card__title">{{ 'general.product_placeholder' | t }}</div>
      <div class="price"><span>{{ 0 | money }}</span></div>
    </div>
  </article>
{%- else -%}
  {%- liquid
    assign on_sale = false
    if product.compare_at_price > product.price
      assign on_sale = true
      assign pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
    endif
    assign is_new = false
    if show_new
      assign new_window = new_days | default: 30 | times: 86400
      assign published_ts = product.published_at | date: '%s' | plus: 0
      assign now_ts = 'now' | date: '%s' | plus: 0
      assign age_secs = now_ts | minus: published_ts
      if age_secs < new_window
        assign is_new = true
      endif
    endif
    assign image_count = product.images.size
    if image_count > 3
      assign image_count = 3
    endif
    assign size_pos = 0
    for opt in product.options_with_values
      assign opt_name = opt.name | downcase
      if opt_name contains 'size' and size_pos == 0
        assign size_pos = opt.position
      endif
    endfor
    if size_pos == 0 and product.options.size == 1
      assign size_pos = 1
    endif
  -%}
  <article class="card" data-product-handle="{{ product.handle }}">
    <div class="card__media">
      <card-gallery>
        <div class="card__track" data-track>
          {%- for image in product.images limit: 3 -%}
            <a class="card__slide" href="{{ product.url }}" {% unless forloop.first %}tabindex="-1" aria-hidden="true"{% endunless %}>
              {{- image | image_url: width: 800 | image_tag: widths: '360, 540, 720, 800', sizes: img_sizes, loading: 'lazy', alt: image.alt | default: product.title -}}
            </a>
          {%- else -%}
            <a class="card__slide" href="{{ product.url }}" style="color:#000" aria-label="{{ product.title | escape }}">{% render 'shoe-placeholder' %}</a>
          {%- endfor -%}
        </div>
        {%- if image_count > 1 -%}
          <button type="button" class="card__arrow card__arrow--prev" data-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-left', size: 18, stroke_width: 2 %}</button>
          <button type="button" class="card__arrow card__arrow--next" data-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-right', size: 18, stroke_width: 2 %}</button>
          <div class="card__dots">
            {%- for i in (1..image_count) -%}
              <button type="button" class="card__dot" data-dot="{{ forloop.index0 }}" aria-label="{{ 'general.show_image' | t: number: i }}" {% if forloop.first %}aria-current="true"{% endif %}><span></span></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </card-gallery>

      <div class="card__badges">
        {%- unless product.available -%}
          <span class="badge badge--sold">{{ 'general.sold_out' | t }}</span>
        {%- else -%}
          {%- if is_new -%}<span class="badge badge--new">{{ 'general.new' | t }}</span>{%- endif -%}
          {%- if on_sale -%}<span class="badge badge--sale">−{{ pct }}%</span>{%- endif -%}
        {%- endunless -%}
      </div>

      {%- if settings.show_wishlist -%}
        <button type="button" class="heart" data-wishlist="{{ product.handle }}" aria-pressed="false" aria-label="{{ 'general.save_item' | t: title: product.title }}">{% render 'icon', name: 'heart', size: 22 %}</button>
      {%- endif -%}

      {%- if qa and product.available -%}
        <div class="card__quick">
          {%- if product.has_only_default_variant -%}
            <button type="button" class="card__add" data-quick-add="{{ product.selected_or_first_available_variant.id }}" aria-label="{{ 'product.add_to_bag_named' | t: title: product.title }}">{{ 'product.add_to_bag' | t }}</button>
          {%- elsif size_pos > 0 -%}
            {%- assign idx = size_pos | minus: 1 -%}
            {%- assign size_name = product.options[idx] -%}
            <span class="label-mono">{{ 'product.quick_add' | t }} · {{ size_name | escape }}</span>
            <div class="card__sizes">
              {%- for opt in product.options_with_values -%}
                {%- if opt.position == size_pos -%}
                  {%- for value in opt.values limit: 12 -%}
                    {%- assign match_id = nil -%}
                    {%- for v in product.variants -%}
                      {%- if v.options[idx] == value and v.available and match_id == nil -%}{%- assign match_id = v.id -%}{%- endif -%}
                    {%- endfor -%}
                    <button type="button" class="card__size" {% if match_id %}data-quick-add="{{ match_id }}"{% else %}disabled{% endif %} aria-label="{{ 'product.add_size_named' | t: title: product.title, size: value }}">{{ value | escape }}</button>
                  {%- endfor -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- else -%}
            <a class="card__add" href="{{ product.url }}" style="display:flex;align-items:center;justify-content:center">{{ 'product.choose_options' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <a class="card__info" href="{{ product.url }}">
      {%- if product.vendor != blank -%}<div class="card__vendor">{{ product.vendor | escape }}</div>{%- endif -%}
      <div class="card__title">{{ product.title | escape }}</div>
      {% render 'price', product: product, show_from: true %}
    </a>
  </article>
{%- endif -%}
