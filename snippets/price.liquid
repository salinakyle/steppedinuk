{%- comment -%}
  Params: product
{%- endcomment -%}
{%- liquid
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}
<span class="price{% if on_sale %} price--sale{% endif %}">
  <span class="price__now">{% if product.price_varies %}From {% endif %}{{ product.price | money }}</span>
  {%- if on_sale -%}
    <s class="price__was"><span class="visually-hidden">Was </span>{{ product.compare_at_price | money }}</s>
  {%- endif -%}
</span>
