{%- comment -%} Param: line (cart line item), index (1-based) {%- endcomment -%}
<div class="cart-line" data-cart-line="{{ line.key }}">
  <a class="cart-line__img" href="{{ line.url }}" tabindex="-1" aria-hidden="true">
    {%- if line.image -%}
      {{- line.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '120px', alt: line.image.alt | default: line.product.title -}}
    {%- else -%}
      <span style="width:80%;color:#000">{% render 'shoe-placeholder' %}</span>
    {%- endif -%}
  </a>
  <div class="cart-line__body">
    {%- if line.vendor != blank -%}<div class="card__vendor">{{ line.vendor | escape }}</div>{%- endif -%}
    <a href="{{ line.url }}" style="font-weight:600;line-height:1.3">{{ line.product.title | escape }}</a>
    {%- unless line.product.has_only_default_variant -%}
      <div class="cart-line__meta">
        {%- for option in line.options_with_values -%}{{ option.name | escape }}: {{ option.value | escape }}{% unless forloop.last %} · {% endunless %}{%- endfor -%}
      </div>
    {%- endunless -%}
    {%- for property in line.properties -%}
      {%- assign first_char = property.first | slice: 0 -%}
      {%- unless property.last == blank or first_char == '_' -%}
        <div class="cart-line__meta">{{ property.first | escape }}: {{ property.last | escape }}</div>
      {%- endunless -%}
    {%- endfor -%}
    {%- if line.selling_plan_allocation -%}<div class="cart-line__meta">{{ line.selling_plan_allocation.selling_plan.name | escape }}</div>{%- endif -%}
    {%- for discount in line.line_level_discount_allocations -%}
      <div class="cart-line__meta">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</div>
    {%- endfor -%}
    <div class="cart-line__row">
      <div class="qty">
        <button type="button" data-cart-change="{{ line.key }}" data-qty="{{ line.quantity | minus: 1 }}" aria-label="{{ 'cart.decrease' | t: title: line.product.title }}">−</button>
        <span class="qty__val" aria-live="polite">{{ line.quantity }}</span>
        <button type="button" data-cart-change="{{ line.key }}" data-qty="{{ line.quantity | plus: 1 }}" aria-label="{{ 'cart.increase' | t: title: line.product.title }}" {% if line.variant.inventory_management == 'shopify' and line.variant.inventory_policy == 'deny' and line.quantity >= line.variant.inventory_quantity %}disabled{% endif %}>+</button>
      </div>
      <div style="text-align:right">
        {%- if line.original_line_price != line.final_line_price -%}
          <s style="color:var(--color-muted);font-size:13px;display:block">{{ line.original_line_price | money }}</s>
        {%- endif -%}
        <strong>{{ line.final_line_price | money }}</strong>
      </div>
    </div>
    <button type="button" class="cart-remove" style="align-self:flex-start" data-cart-change="{{ line.key }}" data-qty="0">{{ 'cart.remove' | t }}</button>
  </div>
</div>
